PORT=4000
FRONTEND_URL=http://localhost:3000

# Shopify Admin API
SHOPIFY_SHOP=your-store-name
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret
SHOPIFY_ADMIN_API_URL=https://your-store.myshopify.com/admin/api/2026-07
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# Database
MONGODB_URI=mongodb://localhost:27017/shopify_backend

# Redis (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# AI (chatbot + recommendations)
GEMINI_API_KEY=your_gemini_api_key

# Vision API (image search)
GOOGLE_VISION_API_KEY=your_vision_api_key

# Cloud Storage (personalization image uploads)
GCS_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=

# Affiliate program
DEFAULT_AFFILIATE_COMMISSION_RATE=0.05

# Discount signup popup
WELCOME_DISCOUNT_CODE=WELCOME10

# Auth (admin/internal routes)
JWT_SECRET=your_jwt_secret_key_change_in_production
